# AgriTwin AI — Server-Side Environment Variables Template

# Application Configuration
APP_NAME="AgriTwin AI"
APP_VERSION="1.0.0"
DEBUG=true
API_PREFIX="/api/v1"

# Database Configuration
# Defaults to SQLite for local development; use PostgreSQL+PostGIS for production
DATABASE_URL="sqlite:///./agritwin.db"
# DATABASE_URL="postgresql://agritwin:secret_pass@localhost:5432/agritwin_db"

# Security & Authentication
SECRET_KEY="change-me-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Agrometeorology & Geospatial Telemetry APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1"
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal"
MODIS_BASE_URL="https://modis.ornl.gov/rst/api/v1"
SENTINEL_HUB_BASE_URL="https://services.sentinel-hub.com"
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# AI Explanation Layer & RAG LLM Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# CORS & Domain Settings (Comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
